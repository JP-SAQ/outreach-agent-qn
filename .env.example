# Google Gemini API Configuration
# Obtain from: https://makersuite.google.com/app/apikey
Gemini_API_Key=your_gemini_api_key_here

# Tavily Search API Configuration
# Obtain from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Email Configuration (Gmail SMTP)
# Use Gmail App Password (not account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@sandboxquantum.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_RECIPIENT=recipient@sandboxquantum.com

# SMTP Server Settings (defaults for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Newsletter Configuration (Optional - defaults shown)
MAX_ARTICLES=10
SEARCH_TIMEOUT=5
LINK_VALIDATION_TIMEOUT=5
COMPANIES_TO_TRACK=EvolutionQ,Qunnect
PREVIOUS_ARTICLES_FILE=sent_articles.txt
OUTPUT_FILE=quantum_newsletter_output.md

# Optional: Additional API Keys (currently unused in main script)
# NEWS_API_KEY=your_news_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# BEEHIIV_API_KEY=your_beehiiv_api_key_here
# BEEHIIV_PUBLICATION_ID=your_publication_id_here

# Optional: RSS Feed URLs (currently unused)
# QUANTUM_NETWORKS_RSS=https://www.google.com/alerts/feeds/...
# QKD_RSS=https://www.google.com/alerts/feeds/...
# QUANTUM_KEY_DISTRIBUTION_RSS=https://www.google.com/alerts/feeds/...
# QUANTUM_COMMUNICATIONS_RSS=https://www.google.com/alerts/feeds/...
# QUNNECT_RSS=https://www.google.com/alerts/feeds/...
# EVOLUTIONQ_RSS=https://www.google.com/alerts/feeds/...
